# Variáveis de ambiente para o portfólio

# Email de contato (opcional - fallback se não estiver definido nas configurações)
VITE_CONTACT_EMAIL=seu-email@dominio.com

# Configurações do EmailJS (não mais usadas no frontend após a atualização de segurança)
# VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# VITE_EMAILJS_ACCESS_TOKEN=public_key_xxxxxxx